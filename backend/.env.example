# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma)
# Replace YOUR_POSTGRES_PASSWORD with your local PostgreSQL password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/portfolio_db?schema=public"

# JWT Authentication
JWT_SECRET="academic_portfolio_jwt_secret_key_super_secure_2026"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,https://profmanojkumar.com"

# Uploads directory
UPLOAD_DIR="uploads"

# SMTP Email Configuration (Contact Notifications)
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT=587
SMTP_USER="noreply@profmanojkumar.com"
SMTP_PASS="your_password"
MAIL_FROM="Prof. Manoj Kumar <noreply@profmanojkumar.com>"

# Website Owner's Receiving Email Address for Inquiries
CONTACT_NOTIFICATION_EMAIL="your-email@example.com"
